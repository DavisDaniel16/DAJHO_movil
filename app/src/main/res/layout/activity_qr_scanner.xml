<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".pos.QrScannerActivity">

    <!-- CameraX PreviewView filling entire screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dark Semi-transparent Overlay Mask around viewfinder target -->
    <!-- Top Bar: Close Button + Title -->
    <LinearLayout
        android:id="@+id/topBarScanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnCloseScanner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_desc"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Busque un código QR"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Viewfinder Target Box with 4 Corner Markers -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewfinderTarget"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top-Left Corner -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_scanner_corner_tl"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Top-Right Corner -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_scanner_corner_tr"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom-Left Corner -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_scanner_corner_bl"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom-Right Corner -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_scanner_corner_br"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Controls Bar: Flashlight + Gallery -->
    <LinearLayout
        android:id="@+id/bottomControlsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Flashlight Button -->
        <ImageButton
            android:id="@+id/btnFlashlight"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_scanner_circle_button"
            android:contentDescription="Linterna"
            android:padding="16dp"
            android:src="@drawable/ic_flash" />

        <!-- Gallery Button -->
        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_scanner_circle_button"
            android:contentDescription="Galería"
            android:padding="16dp"
            android:src="@drawable/ic_gallery" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
