<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_product"
    android:padding="14dp">

    <!-- Client Name -->
    <TextView
        android:id="@+id/tvDebtorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvDebtorAmount"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Carlos Alberto Mendoza" />

    <!-- Phone -->
    <TextView
        android:id="@+id/tvDebtorPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvDebtorAmount"
        app:layout_constraintTop_toBottomOf="@id/tvDebtorName"
        tools:text="098 765 4321" />

    <!-- Pending Debt Amount Badge (Red) -->
    <TextView
        android:id="@+id/tvDebtorAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_red"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/badge_red_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="$28.50" />

    <!-- Action Button: Registrar Abono -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCollectDebt"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_black"
        android:paddingHorizontal="16dp"
        android:text="@string/btn_pay_debt"
        android:textColor="@color/btn_text_color"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDebtorAmount" />

</androidx.constraintlayout.widget.ConstraintLayout>
