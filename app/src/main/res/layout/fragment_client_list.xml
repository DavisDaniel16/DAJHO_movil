<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".clients.ClientListFragment">

    <!-- Sub-Tabs: Por cobrar | Por pagar -->
    <LinearLayout
        android:id="@+id/tabHeaderDeudas"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/card_background"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabPorCobrar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Por cobrar"
            android:textColor="@color/btn_black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabPorPagar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Por pagar"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Active Indicator Underline (Half Width of Screen) -->
    <View
        android:id="@+id/tabUnderlineDeudas"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/btn_black"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintTop_toBottomOf="@id/tabHeaderDeudas"
        app:layout_constraintStart_toStartOf="@id/tabHeaderDeudas" />

    <!-- Button: Reportes -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReportsDeudas"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_outline"
        android:drawableStart="@drawable/ic_receipt"
        android:drawablePadding="6dp"
        android:paddingHorizontal="20dp"
        android:text="Reportes"
        android:textColor="@color/btn_black"
        android:textSize="12sp"
        android:textStyle="bold"
        app:drawableTint="@color/btn_black"
        app:layout_constraintTop_toBottomOf="@id/tabUnderlineDeudas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Total Debt Summary Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTotalDebtSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnReportsDeudas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTotalDebtAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$43.50"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalDebtorsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2 Clientes con deuda"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/badgeDebtorsCount"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/badge_green_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Search Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/searchBarClient"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_bar"
        app:layout_constraintTop_toBottomOf="@id/cardTotalDebtSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivSearchClientIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/btn_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <EditText
            android:id="@+id/etSearchClient"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/transparent"
            android:hint="@string/hint_search_client"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/ivSearchClientIcon"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Client / Debtor List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClients"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/searchBarClient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_client"
        tools:itemCount="3" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyClients"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_clients"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchBarClient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <!-- Bottom Floating Action Pills -->
    <LinearLayout
        android:id="@+id/bottomActionPillsDeudas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Green Button: + Nueva venta -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewSaleFloatingDeudas"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_black"
            android:backgroundTint="@color/btn_green_action"
            android:text="+ Nueva venta"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Dark Button: + Crear Cliente / Proveedor -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewClientFloating"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_black"
            android:text="+ Crear cliente"
            android:textColor="@color/btn_text_color"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
