<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBizName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre del Negocio"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvBizRimpe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIMPE"
                android:textSize="11sp"
                android:textColor="#B71C1C"
                android:background="#FFEBEE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBizRuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RUC: 0999999999001"
            android:textSize="13sp"
            android:textColor="#555555"
            android:paddingTop="6dp" />

        <TextView
            android:id="@+id/tvBizPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teléfono: 0987654321"
            android:textSize="13sp"
            android:textColor="#555555"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/tvBizAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dirección: Av. Principal y Calle B"
            android:textSize="13sp"
            android:textColor="#777777"
            android:paddingTop="2dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
