<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_yellow"
    tools:context=".HomeActivity">

    <!-- Top Yellow Banner (Treinta Style Header) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Profile Icon Circle -->
        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_scanner_circle_button"
            android:backgroundTint="#20000000"
            android:src="@drawable/ic_profile"
            android:padding="8dp"
            app:tint="@color/btn_black"
            android:contentDescription="@string/profile_desc" />

        <!-- Business Name & Owner Dropdown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBusinessName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Nombre del negocio"
                    android:textColor="@color/btn_black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="270"
                    app:tint="@color/btn_black"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#5A5515"
                android:textSize="12sp"
                tools:text="Propietario" />
        </LinearLayout>

        <!-- Search / Filter Icons -->
        <ImageButton
            android:id="@+id/btnHeaderSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/btn_black"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btnHeaderFilter"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/btn_black"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Date Strip Bar (Treinta Style) -->
    <LinearLayout
        android:id="@+id/dateStripBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/chipDateMinus3"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            tools:text="22 oct"
            android:textColor="@color/btn_black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipDateMinus2"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            tools:text="23 oct"
            android:textColor="@color/btn_black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipDateMinus1"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            tools:text="24 oct"
            android:textColor="@color/btn_black"
            android:textSize="12sp" />

        <!-- Selected Active Date (Dark Pill #121826 with white text) -->
        <TextView
            android:id="@+id/chipDateSelected"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            tools:text="25 oct"
            android:textColor="@color/btn_text_color"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnCalendarPicker"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_receipt"
            app:tint="@color/btn_black"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Main Module Container (White Body) -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/app_background"
        app:layout_constraintTop_toBottomOf="@id/dateStripBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation Bar (5 Tabs Treinta Style) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
